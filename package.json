{
  "name": "hifi-repeater",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "node scripts/dev-cert.mjs && vite --mode https",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:https": "node scripts/dev-cert.mjs && vite preview --mode https",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "cert:dev": "node scripts/dev-cert.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
